    replacement_infos {
      original_chunk {
        target_content: "            <div className=\"bg-gradient-to-b from-stone-900/95 to-stone-950/100 border border-amber-500/15 rounded-2xl p-6 shadow-[0_0_30px_rgba(245,158,11,0.05)] relative overflow-hidden group\">\n              {/* Highlight Overlay Glow */}\n              <div className=\"absolute top-0 right-0 w-32 h-32 bg-amber-500/5 rounded-full blur-2xl group-hover:bg-amber-500/10 transition-all duration-300 pointer-events-none\" />\n              <div className=\"absolute bottom-0 left-0 w-32 h-32 bg-stone-500/5 rounded-full blur-2xl group-hover:bg-amber-500/5 transition-all duration-300 pointer-events-none\" />\n\n              {/* Professional Card Header */}\n              <div className=\"flex items-center justify-between border-b border-stone-850 pb-4 mb-4\">\n                <div className=\"flex items-center space-x-2\">\n                  <span className=\"flex h-1.5 w-1.5 rounded-full bg-amber-400 animate-pulse\" />\n                  <span className=\"text-[10px] font-mono tracking-wider text-amber-400 uppercase font-bold\">\n                    Executive Portfolio Desk\n                  </span>\n                </div>\n                <div className=\"bg-amber-500/10 text-amber-400 border border-amber-500/20 text-[9px] font-mono px-2 py-0.5 rounded font-bold\">\n                  VERIFIED DEEDS\n                </div>\n              </div>\n\n              {/* CEO Portrait Header & Physical/Asset Strategy Profile */}\n              <div className=\"flex flex-col space-y-4\">\n                <div className=\"relative w-full h-[465px] rounded-xl overflow-hidden border border-stone-850 bg-stone-900 shadow-inner group-hover:border-amber-500/25 transition-all duration-300\">\n                  <img \n                    src={gydenHengImg} \n                    alt=\"GYDEN CEO Gyden Heng\"\n                    referrerPolicy=\"no-referrer\"\n                    className=\"w-full h-full object-cover object-top hover:scale-[1.015] transition-transform duration-500\"\n                    style={{ \n                      imageRendering: \'auto\',\n                      filter: \'contrast(1.02) brightness(1.02)\'\n                    }}\n                  />\n                  {/* Floating Biometric Overlay */}\n                  <div className=\"absolute bottom-0 inset-x-0 bg-gradient-to-t from-stone-950 via-stone-950/80 to-transparent p-5 flex flex-col justify-end\">\n                    <div className=\"flex justify-between items-end\">\n                      <div>\n                        <span className=\"text-[10px] text-amber-400 font-mono uppercase tracking-widest block font-bold\">GREC CEO & FOUNDER</span>\n                        <h3 className=\"text-lg font-bold tracking-tight text-white font-sans\">Gyden Heng</h3>\n                      </div>\n                      <div className=\"bg-amber-500/15 backdrop-blur-md px-2.5 py-1 rounded border border-amber-500/30 text-[9px] font-mono font-bold text-amber-300 uppercase\">\n                        Exp: 7+ Years\n                      </div>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Interactive CEO Quote & Discipline Statement */}\n                <div className=\"bg-stone-900/60 p-4 rounded-xl border border-stone-850 relative z-10\">\n                  <p className=\"text-xs text-stone-300 leading-relaxed font-sans italic\">\n                    \"Every capital allocation layout is processed personally to GREC specifications. Peak personal focus and analytical selection represent the core of high-multiple yield engineering.\"\n                  </p>\n                  <span className=\"text-[9px] font-mono font-bold tracking-wider text-amber-400 uppercase mt-2.5 block text-right\">\342\200\224 Executive Desk Code</span>\n                </div>\n\n                {/* Key Metrics Dashboard & Vitals Grid */}\n                <div className=\"grid grid-cols-2 gap-3 py-1\">\n                  <div