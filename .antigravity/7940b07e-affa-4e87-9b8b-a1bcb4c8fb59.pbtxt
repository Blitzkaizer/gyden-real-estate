    instruction: "Update Hero\'s CEO card with professional, polished real estate credentials highlighting 7+ years of experience and clean luxury gradients."
    replacement_infos {
      original_chunk {
        target_content: "          {/* Interactive Portal Overview Widget / CEO Portrait Card - Column 5 */}\n          <motion.div \n            variants={itemVariants}\n            className=\"lg:col-span-5 relative\"\n          >\n            <div className=\"bg-gradient-to-b from-stone-900/90 to-stone-950/95 border border-emerald-500/25 rounded-2xl p-6 shadow-[0_0_30px_rgba(16,185,129,0.1)] relative overflow-hidden group\">\n              {/* Highlight Overlay Glow */}\n              <div className=\"absolute top-0 right-0 w-32 h-32 bg-emerald-500/10 rounded-full blur-2xl group-hover:bg-emerald-500/15 transition-all duration-300\" />\n              <div className=\"absolute bottom-0 left-0 w-32 h-32 bg-amber-500/10 rounded-full blur-2xl group-hover:bg-amber-500/15 transition-all duration-300\" />\n\n              <div className=\"absolute -top-3 -right-3 bg-gradient-to-r from-emerald-500 to-amber-500 text-stone-950 text-[10px] font-mono tracking-widest px-3 py-1 rounded font-bold uppercase shadow-md z-15\">\n                Executive Desk Veto\n              </div>\n\n              {/* CEO Portrait Header & Physical/Asset Strategy Profile */}\n              <div className=\"flex flex-col space-y-4\">\n                <div className=\"relative w-full h-80 rounded-xl overflow-hidden border border-stone-800 bg-stone-900 shadow-inner group-hover:border-emerald-500/30 transition-all duration-300\">\n                  <img \n                    src=\"/src/assets/images/gyden_heng_1779443461362.png\" \n                    alt=\"GYDEN CEO Gyden Heng\"\n                    referrerPolicy=\"no-referrer\"\n                    className=\"w-full h-full object-cover object-top hover:scale-[1.03] transition-transform duration-500\"\n                  />\n                  {/* Floating Biometric Overlay */}\n                  <div className=\"absolute bottom-0 inset-x-0 bg-gradient-to-t from-stone-950 via-stone-950/70 to-transparent p-4 flex flex-col justify-end\">\n                    <div className=\"flex justify-between items-end\">\n                      <div>\n                        <span className=\"text-[10px] text-emerald-400 font-mono uppercase tracking-widest block font-bold\">GREC Founder & CEO</span>\n                        <h3 className=\"text-lg font-bold tracking-tight text-white font-sans\">Gyden Heng</h3>\n                      </div>\n                      <div className=\"bg-emerald-500/20 backdrop-blur-md px-2 py-1 rounded border border-emerald-500/30 text-[9px] font-mono font-bold text-emerald-300 uppercase\">\n                        Vigor Index: 100%\n                      </div>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Interactive CEO Quote & Discipline Statement */}\n                <div className=\"bg-stone-900/60 p-4 rounded-xl border border-stone-800 relative z-10\">\n                  <p className=\"text-xs text-stone-300 leading-relaxed font-sans italic\">\n                    \"Peak athletic discipline and asset allocation rigor are built from the same core principle. A focused mind secures high capital multiples and mitigates freehold risks.\"\n                  </p>\n                  <span className=\"text-[9px] font-mono font-bold tracking-wider text-amber-500 uppercase mt-2.5 block text-right\">\342\200\224 Executive Portfolio Model</span>\n                </div>\n\n                {/* Key Metrics Dashboard & Vitals Grid */}\n                <div className=\"grid grid-cols-2 gap-3 py-1\">\n                  <div className=\"bg-stone-950 p-2.5 rounded border border-stone-850\">\n                    <span className=\"text-[9px] font-mono text-stone-500 uppercase block tracking-wider\">Physical Vigor</span>\n                    <span className=\"text-xs font-bold text-emerald-400\">Peak Performance</span>\n                  </div>\n                  <div className=\"bg-stone-950 p-2.5 rounded border border-stone-850\">\n                    <span className=\"text-[9px] font-mono text-stone-500 uppercase block tracking-wider\">Executive Authority</span>\n                    <span className=\"text-xs font-bold text-amber-400\">Direct Developer Veto</span>\n                  </div>\n                </div>\n\n                {/* Workspace Verification Badges */}\n                <div className=\"space-y-2\">\n                  <h4 className=\"text-[10px] text-emerald-400 uppercase font-bold tracking-widest font-mono\">Active Johor Real Estate Grids</h4>\n                  \n                  <div className=\"flex items-center justify-between text-xs text-stone-300 bg-stone-900/40 p-2.5 rounded border border-stone-850 hover:bg-stone-905 transition-colors\">\n                    <div className=\"flex items-center space-x-2\">\n                      <CheckCircle className=\"h-3.5 w-3.5 text-emerald-400 shrink-0\" />\n                      <span>Johor RTS Transit Corridor Map</span>\n                    </div>\n                    <span className=\"text-[9px] bg-emerald-500/10 text-emerald-300 px-2 py-0.5 rounded font-mono font-semibold uppercase\">SA003 Active</span>\n                  </div>\n\n                  <div className=\"flex items-center justify-between text-xs text-stone-300 bg-stone-900/40 p-2.5 rounded border border-stone-850 hover:bg-stone-905 transition-colors\">\n                    <div className=\"flex items-center space-x-2\">\n                      <CheckCircle className=\"h-3.5 w-3.5 text-emerald-400 shrink-0\" />\n                      <span>Freehold Water-Front Hub Index</span>\n                    </div>\n                    <span className=\"text-[9px] bg-amber-500/10 text-amber-300 px-2 py-0.5 rounded font-mono font-semibold uppercase\">SA001 Vetted</span>\n                  </div>\n                </div>\n\n              </div>\n            </div>\n          </motion.div>"
        replacement_content: "          {/* Interactive Portal Overview Widget / CEO Portrait Card - Column 5 */}\n          <motion.div \n            variants={itemVariants}\n            className=\"lg:col-span-5 relative\"\n          >\n            <div className=\"bg-gradient-to-b from-stone-900/90 to-stone-950/95 border border-amber-500/20 rounded-2xl p-6 shadow-[0_0_30px_rgba(245,158,11,0.06)] relative overflow-hidden group\">\n              {/* Highlight Overlay Glow */}\n              <div className=\"absolute top-0 right-0 w-32 h-32 bg-amber-500/5 rounded-full blur-2xl group-hover:bg-amber-500/10 transition-all duration-300\" />\n              <div className=\"absolute bottom-0 left-0 w-32 h-32 bg-stone-500/5 rounded-full blur-2xl group-hover:bg-amber-500/5 transition-all duration-300\" />\n\n              <div className=\"absolute -top-3 -right-3 bg-gradient-to-r from-amber-500 to-amber-600 text-stone-950 text-[10px] font-mono tracking-widest px-3 py-1 rounded font-bold uppercase shadow-md z-15\">\n                Executive Portfolio Desk\n              </div>\n\n              {/* CEO Portrait Header & Physical/Asset Strategy Profile */}\n              <div className=\"flex flex-col space-y-4\">\n                <div className=\"relative w-full h-80 rounded-xl overflow-hidden border border-stone-850 bg-stone-900 shadow-inner group-hover:border-amber-500/25 transition-all duration-300\">\n                  <img \n                    src=\"/src/assets/images/gyden_heng_1779443461362.png\" \n                    alt=\"GYDEN CEO Gyden Heng\"\n                    referrerPolicy=\"no-referrer\"\n                    className=\"w-full h-full object-cover object-top contrast-[1.03] brightness-[1.05] saturate-[0.98] hover:scale-[1.02] transition-transform duration-500\"\n                    style={{ imageRendering: \'auto\' }}\n                  />\n                  {/* Floating Biometric Overlay */}\n                  <div className=\"absolute bottom-0 inset-x-0 bg-gradient-to-t from-stone-950 via-stone-950/75 to-transparent p-4 flex flex-col justify-end\">\n                    <div className=\"flex justify-between items-end\">\n                      <div>\n                        <span className=\"text-[10px] text-amber-400 font-mono uppercase tracking-widest block font-bold\">GREC CEO & FOUNDER</span>\n                        <h3 className=\"text-lg font-bold tracking-tight text-white font-sans\">Gyden Heng</h3>\n                      </div>\n                      <div className=\"bg-amber-500/15 backdrop-blur-md px-2.5 py-1 rounded border border-amber-500/30 text-[9px] font-mono font-bold text-amber-300 uppercase\">\n                        Exp: 7+ Years\n                      </div>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Interactive CEO Quote & Discipline Statement */}\n                <div className=\"bg-stone-900/60 p-4 rounded-xl border border-stone-850 relative z-10\">\n                  <p className=\"text-xs text-stone-300 leading-relaxed font-sans italic\">\n                    \"Every capital allocation layout is processed personally to GREC specifications. Peak personal focus and analytical selection represent the core of high-multiple yield engineering.\"\n                  </p>\n                  <span className=\"text-[9px] font-mono font-bold tracking-wider text-amber-400 uppercase mt-2.5 block text-right\">\342\200\224 Executive Desk Code</span>\n                </div>\n\n                {/* Key Metrics Dashboard & Vitals Grid */}\n                <div className=\"grid grid-cols-2 gap-3 py-1\">\n                  <div className=\"bg-stone-950 p-2.5 rounded border border-stone-850\">\n                    <span className=\"text-[9px] font-mono text-stone-500 uppercase block tracking-wider\">Leadership Status</span>\n                    <span className=\"text-xs font-bold text-stone-200\">CEO of GREC</span>\n                  </div>\n                  <div className=\"bg-stone-950 p-2.5 rounded border border-stone-850\">\n                    <span className=\"text-[9px] font-mono text-stone-500 uppercase block tracking-wider\">Acquisition Vetting</span>\n                    <span className=\"text-xs font-bold text-amber-400\">Direct Nominee Veto</span>\n                  </div>\n                </div>\n\n                {/* Workspace Verification Badges */}\n                <div className=\"space-y-2\">\n                  <h4 className=\"text-[10px] text-amber-400 uppercase font-bold tracking-widest font-mono\">Active Johor Real Estate Grids</h4>\n                  \n                  <div className=\"flex items-center justify-between text-xs text-stone-300 bg-stone-900/40 p-2.5 rounded border border-stone-850 hover:bg-stone-800/40 transition-colors\">\n                    <div className=\"flex items-center space-x-2\">\n                      <CheckCircle className=\"h-3.5 w-3.5 text-amber-500 shrink-0\" />\n                      <span>Johor RTS Transit Corridor Map</span>\n                    </div>\n                    <span className=\"text-[9px] bg-amber-500/10 text-amber-300 px-2 py-0.5 rounded font-mono font-semibold uppercase\">SA003 Active</span>\n                  </div>\n\n                  <div className=\"flex items-center justify-between text-xs text-stone-300 bg-stone-900/40 p-2.5 rounded border border-stone-850 hover:bg-stone-800/40 transition-colors\">\n                    <div className=\"flex items-center space-x-2\">\n                      <CheckCircle className=\"h-3.5 w-3.5 text-amber-500 shrink-0\" />\n                      <span>Freehold Water-Front Hub Index</span>\n                    </div>\n                    <span className=\"text-[9px] bg-amber-500/10 text-amber-300 px-2 py-0.5 rounded font-mono font-semibold uppercase\">SA001 Vetted</span>\n                  </div>\n                </div>\n\n              </div>\n            </div>\n          </motion.div>"
      }
