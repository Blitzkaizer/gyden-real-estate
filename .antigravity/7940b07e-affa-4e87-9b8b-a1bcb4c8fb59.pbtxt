    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { motion } from \"motion/react\";\nimport { ShieldCheck, Award, Users, BarChart3, ChevronDown, CheckCircle, MapPin } from \"lucide-react\";\n\ninterface HeroProps {\n  onExploreProperties: () => void;\n  onConsultAdvisor: () => void;\n}\n\nexport default function Hero({ onExploreProperties, onConsultAdvisor }: HeroProps) {\n  const coreStats = [\n    { label: \"Acquisitions Vetted\", value: \"RM 240M+\", desc: \"Johor & SEA region\" },\n    { label: \"RTS Corridor Growth\", value: \"25% YoY\", desc: \"Projected Central JB cap\" },\n    { label: \"Allocations Engineered\", value: \"120+\", desc: \"Corporate & private portfolios\" },\n    { label: \"Strategic Client Yield\", value: \"6.8% Average\", desc: \"Commercial & residential blended\" }\n  ];\n\n  return (\n    <header id=\"hero\" className=\"relative min-h-screen pt-28 flex flex-col justify-center bg-stone-950 text-stone-100 overflow-hidden\">\n      {/* Decorative premium radial shadow glows */}\n      <div className=\"absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-gradient-to-tr from-amber-500/5 to-amber-700/5 rounded-full blur-[120px] pointer-events-none\" />\n      <div className=\"absolute bottom-10 right-10 w-[600px] h-[600px] bg-gradient-to-tr from-stone-800/20 to-transparent rounded-full blur-[150px] pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full py-12\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n          \n          {/* Main Hero Copy - Column 7 */}\n          <div className=\"lg:col-span-7 flex flex-col space-y-6\">\n            \n            {/* Top Badge */}\n            <div className=\"inline-flex items-center space-x-2 bg-stone-900 border border-stone-800 rounded-full px-3 py-1.5 w-fit\">\n              <span className=\"flex h-2 w-2 rounded-full bg-amber-500\" />\n              <span className=\"text-[11px] font-mono tracking-widest text-amber-400 uppercase font-bold\">\n                Official Portfolio Workspace & Legal Archive\n              </span>\n            </div>\n\n            {/* Title / Heading */}\n            <h1 className=\"text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight font-sans text-stone-100 leading-tight\">\n              Optimized <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-amber-200 via-amber-400 to-amber-500\">Asset Allocation</span> & One-Stop Real Estate Solutions\n            </h1>\n\n            {/* CEO Credit and Concept */}\n            <p className=\"text-stone-300 text-base sm:text-lg max-w-2xl leading-relaxed font-sans\">\n              Founded by the CEO, <strong className=\"text-amber-400 font-semibold text-stone-200\">Gyden Heng</strong>. GYDEN Real Estate Group (GREC) engineers robust risk-adjusted portfolios within fast-growing commercial, luxury residential, and industrial nodes. We secure direct developer pricing and handle full-cycle acquisition documents.\n            </p>\n\n            {/* Two Tier CTAs */}\n            <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-4\">\n              <button\n                id=\"hero-explore-properties-btn\"\n                onClick={onExploreProperties}\n                className=\"px-8 py-3.5 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-stone-950 font-bold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 text-center\"\n              >\n                Inspect Portfolio Database\n              </button>\n              <button\n                id=\"hero-ai-advisor-btn\"\n                onClick={onConsultAdvisor}\n                className=\"px-8 py-3.5 bg-stone-900 hover:bg-stone-805 border border-stone-800 text-amber-400 font-semibold rounded-lg hover:text-amber-300 transition-all duration-200 text-center flex items-center justify-center space-x-2\"\n              >\n                <span>Consult IA Investment Advisor</span>\n              </button>\n            </div>\n\n            {/* Brand pillars */}\n            <div className=\"grid grid-cols-2 md:grid-cols-3 gap-y-3 gap-x-6 pt-6 border-t border-stone-900\">\n              <div className=\"flex items-center space-x-2 text-stone-400\">\n                <ShieldCheck className=\"h-4 w-4 text-emerald-500 shrink-0\" />\n                <span className=\"text-xs font-mono\">Assessed Title Deeds</span>\n              </div>\n              <div className=\"flex items-center space-x-2 text-stone-400\">\n                <Award className=\"h-4 w-4 text-amber-500 shrink-0\" />\n                <span className=\"text-xs font-mono\">Vetted Legal Annexes</span>\n              </div>\n              <div className=\"flex items-center space-x-2 text-stone-400\">\n                <Users className=\"h-4 w-4 text-blue-500 shrink-0\" />\n                <span className=\"text-xs font-mono\">CEO Direct Acquisition Veto</span>\n              </div>\n            </div>\n\n          </div>\n\n          {/* Interactive Portal Overview Widget - Column 5 */}\n          <div className=\"lg:col-span-5 relative\">\n            <div className=\"bg-gradient-to-b from-stone-900 to-stone-950 border border-stone-800 rounded-2xl p-6 shadow-2xl relative\">\n              <div className=\"absolute -top-3 -right-3 bg-amber-500 text-stone-950 text-[10px] font-mono tracking-wider px-2 py-1 rounded font-bold uppercase shadow-md\">\n                Secure Preview Mode\n              </div>\n\n              {/* CEO Focus Memo */}\n              <div className=\"flex items-start space-x-4 pb-5 border-b border-stone-800\">\n                <div className=\"bg-amber-500/10 p-2.5 rounded-xl border border-amber-500/30 shrink-0\">\n                  <BarChart3 className=\"h-5 w-5 text-amber-400\" />\n                </div>\n                <div>\n                  <h3 className=\"text-sm font-semibold tracking-wide text-stone-200\">The Gyden Allocation Strategy</h3>\n                  <p className=\"text-xs text-stone-400 leading-relaxed mt-1\">\n                    \"Do not buy property speculatively. We allocate capital relative to core infrastructure markers\342\200\224such as the RTS Transit line connecting JB & Singapore. Secure high yields today while maintaining freehold risk mitigation.\"\n                  </p>\n                  <span className=\"text-[10px] font-semibold text-amber-500 uppercase mt-2 block tracking-wider\">\342\200\224 Gyden Heng, CEO & Founder</span>\n                </div>\n              </div>\n\n              {/* Feature Points of the GREC Portal */}\n              <div className=\"py-5 space-y-3\">\n                <h4 className=\"text-xs text-amber-500 uppercase font-bold tracking-widest font-mono\">Key Workspace Capabilities</h4>\n                \n                <div className=\"flex items-center justify-between text-xs text-stone-300 bg-stone-900/50 p-2.5 rounded border border-stone-800\">\n                  <div className=\"flex items-center space-x-2\">\n                    <CheckCircle className=\"h-3.5 w-3.5 text-amber-400 shrink-0\" />\n                    <span>Malaysian RTS Corridor Real-Time Grids</span>\n                  </div>\n                  <span className=\"text-[10px] bg-stone-800 text-orange-400 px-1.5 py-0.5 rounded uppercase font-mono\">SA003 Active</span>\n                </div>\n\n                <div className=\"flex items-center justify-between text-xs text-stone-300 bg-stone-900/50 p-2.5 rounded border border-stone-800\">\n                  <div className=\"flex items-center space-x-2\">\n                    <CheckCircle className=\"h-3.5 w-3.5 text-amber-400 shrink-0\" />\n                    <span>Integrated Legal Document Vault (PREVIEW)</span>\n                  </div>\n                  <span className=\"text-[10px] bg-stone-800 text-emerald-400 px-1.5 py-0.5 rounded uppercase font-mono\">7 Files Secure</span>\n                </div>\n\n                <div className=\"flex items-center justify-between text-xs text-stone-300 bg-stone-900/50 p-2.5 rounded border border-stone-800\">\n                  <div className=\"flex items-center space-x-2\">\n                    <CheckCircle className=\"h-3.5 w-3.5 text-amber-400 shrink-0\" />\n                    <span>Dynamic Compound Yield projection Index</span>\n                  </div>\n                  <span className=\"text-[10px] bg-stone-800 text-stone-400 px-1.5 py-0.5 rounded uppercase font-mono\">6 Strategy Mix</span>\n                </div>\n              </div>\n\n              <div className=\"bg-stone-950 p-3.5 rounded border border-stone-850\">\n                <div className=\"flex items-center justify-between text-xs text-stone-400 font-mono\">\n                  <div className=\"flex items-center space-x-1.5\">\n                    <MapPin className=\"h-3.5 w-3.5 text-amber-500\" />\n                    <span>Sector Hotspot</span>\n                  </div>\n                  <span className=\"text-stone-300 font-semibold\">Johor Bahru Waterfront & CBD</span>\n                </div>\n              </div>\n\n            </div>\n          </div>\n        </div>\n\n        {/* Hero Bottom Core Stats Grid */}\n        <section id=\"grec-metrics\" className=\"grid grid-cols-2 lg:grid-cols-4 gap-6 pt-16 mt-16 border-t border-stone-900\">\n          {coreStats.map((stat, i) => (\n            <div key={i} className=\"bg-stone-900/40 border border-stone-900 p-5 rounded-xl flex flex-col justify-between\">\n              <div>\n                <span className=\"text-2xl sm:text-3xl font-bold font-sans text-stone-100 block tracking-tight\">\n                  {stat.value}\n                </span>\n                <span className=\"text-xs font-semibold text-amber-400 font-mono tracking-wider block mt-1 uppercase text-[10px]\">\n                  {stat.label}\n                </span>\n              </div>\n              <p className=\"text-xs text-stone-400 mt-2 font-sans border-l-2 border-stone-800 pl-2 leading-relaxed\">\n                {stat.desc}\n              </p>\n            </div>\n          ))}\n        </section>\n\n        {/* Animated Chevron Indicator */}\n        <div className=\"flex justify-center pt-8 pointer-events-none mt-4\">\n          <ChevronDown className=\"h-5 w-5 text-stone-500 animate-bounce\" />\n        </div>\n\n      </div>\n    </header>\n  );\n}\n"
    }
