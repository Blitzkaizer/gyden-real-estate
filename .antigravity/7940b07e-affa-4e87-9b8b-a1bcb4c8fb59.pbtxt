0/50 p-2.5 rounded border border-stone-800\">\n                  <div className=\"flex items-center space-x-2\">\n                    <CheckCircle className=\"h-3.5 w-3.5 text-amber-400 shrink-0\" />\n                    <span>Malaysian RTS Corridor Real-Time Grids</span>\n                  </div>\n                  <span className=\"text-[10px] bg-stone-800 text-orange-400 px-1.5 py-0.5 rounded uppercase font-mono\">SA003 Active</span>\n                </div>\n\n                <div className=\"flex items-center justify-between text-xs text-stone-300 bg-stone-900/50 p-2.5 rounded border border-stone-800\">\n                  <div className=\"flex items-center space-x-2\">\n                    <CheckCircle className=\"h-3.5 w-3.5 text-amber-400 shrink-0\" />\n                    <span>Integrated Legal Document Vault (PREVIEW)</span>\n                  </div>\n                  <span className=\"text-[10px] bg-stone-800 text-emerald-400 px-1.5 py-0.5 rounded uppercase font-mono\">7 Files Secure</span>\n                </div>\n\n                <div className=\"flex items-center justify-between text-xs text-stone-300 bg-stone-900/50 p-2.5 rounded border border-stone-800\">\n                  <div className=\"flex items-center space-x-2\">\n                    <CheckCircle className=\"h-3.5 w-3.5 text-amber-400 shrink-0\" />\n                    <span>Dynamic Compound Yield projection Index</span>\n                  </div>\n                  <span className=\"text-[10px] bg-stone-800 text-stone-400 px-1.5 py-0.5 rounded uppercase font-mono\">6 Strategy Mix</span>\n                </div>\n              </div>\n\n              <div className=\"bg-stone-950 p-3.5 rounded border border-stone-850\">\n                <div className=\"flex items-center justify-between text-xs text-stone-400 font-mono\">\n                  <div className=\"flex items-center space-x-1.5\">\n                    <MapPin className=\"h-3.5 w-3.5 text-amber-500\" />\n                    <span>Sector